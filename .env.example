# Copy this file to .env for local development. Never commit .env.

# MongoDB Atlas: create a free shared cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=threat_intel

# AlienVault OTX: create a free account and obtain the API key from the OTX user settings page.
OTX_API_KEY=replace_with_otx_api_key

# VirusTotal: obtain the public API key from a free VirusTotal account.
VT_API_KEY=replace_with_virustotal_public_api_key

# AbuseIPDB: create a free account and generate an API key in the API section.
ABUSEIPDB_API_KEY=replace_with_abuseipdb_api_key

# Optional future MISP fixture/adapter settings. MISP is not required for local operation.
MISP_URL=
MISP_API_KEY=

# Application settings
API_HOST=127.0.0.1
API_PORT=8000
INGEST_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
